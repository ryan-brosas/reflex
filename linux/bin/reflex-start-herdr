#!/bin/sh
# Start herdr headless through its user unit. The unit is installed by
# install-omarchy.sh when herdr is present; a terminal is only the fallback for
# an older install or a machine without a user systemd bus.
set -u
if systemctl --user start herdr.service 2>/dev/null &&
   systemctl --user is-active --quiet herdr.service; then
  exit 0
fi
exec omarchy-launch-terminal-herdr
