#!/usr/bin/env bash
# Reflex shell preferences, kept apart from secrets and service environment.
# A tiny JSON store so the bar, the overlay and this helper agree.
set -euo pipefail

file="${XDG_CONFIG_HOME:-$HOME/.config}/reflex/settings.json"
mkdir -p "$(dirname "$file")"

defaults='{"railReserve":true,"surfaceQuestions":true,"keepAwake":true,"embeddedTerminal":true,"newHarness":"claude"}'

ensure() {
  if [ ! -s "$file" ]; then
    umask 077
    printf '%s\n' "$defaults" > "$file"
  fi
  chmod 600 "$file" 2>/dev/null || true
}

valid_key() {
  case "$1" in
    railReserve|surfaceQuestions|keepAwake|embeddedTerminal|newHarness) return 0 ;;
    *) return 1 ;;
  esac
}

get_value() {
  local key=$1 value
  ensure
  value=$(jq -r --arg k "$key" 'if has($k) then .[$k] else empty end' "$file" 2>/dev/null || true)
  if [ -z "$value" ]; then
    value=$(printf '%s' "$defaults" | jq -r --arg k "$key" '.[$k]')
  fi
  printf '%s\n' "$value"
}

set_value() {
  local key=$1 value=$2 tmp
  valid_key "$key" || { echo "unknown setting: $key" >&2; exit 2; }
  case "$key" in
    railReserve|surfaceQuestions|keepAwake|embeddedTerminal)
      case "$value" in true|false) ;; *) echo "$key expects true or false" >&2; exit 2 ;; esac
      ;;
    newHarness)
      printf '%s' "$value" | grep -Eq '^[A-Za-z0-9_-]{1,32}$' || { echo "invalid harness" >&2; exit 2; }
      ;;
  esac
  ensure
  tmp=$(mktemp "$file.XXXXXX")
  trap 'rm -f "$tmp"' EXIT
  jq --arg k "$key" --arg v "$value" '
    if ($k == "newHarness") then .[$k] = $v
    else .[$k] = ($v == "true")
    end' "$file" > "$tmp"
  chmod 600 "$tmp"
  mv "$tmp" "$file"
  trap - EXIT
  printf '%s\n' "$value"
}

ensure
case "${1:-}" in
  get)
    [ -n "${2:-}" ] || { echo "usage: reflex-settings get <key>" >&2; exit 2; }
    get_value "$2"
    ;;
  set)
    [ -n "${2:-}" ] && [ -n "${3:-}" ] || { echo "usage: reflex-settings set <key> <value>" >&2; exit 2; }
    set_value "$2" "$3"
    ;;
  json)
    ensure
    # Fill missing keys from defaults without dropping a user's values.
    jq -s '.[0] * .[1]' <(printf '%s' "$defaults") "$file"
    ;;
  *)
    echo "usage: reflex-settings get <key> | set <key> <value> | json" >&2
    exit 2
    ;;
esac
